# Truenex Memory — LLM Sidecar Configuration
# Copy this file to .env and customize values for your environment.

# HuggingFace repository ID containing the GGUF model
TRUENEX_LLM_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF

# Specific GGUF filename inside the repo
TRUENEX_LLM_FILE=qwen2.5-7b-instruct-q4_k_m.gguf

# HuggingFace base URL (change to mirror if needed)
TRUENEX_HF_BASE_URL=https://huggingface.co

# Minimum file size (bytes) to consider a model download complete
TRUENEX_LLM_MIN_BYTES=1048576

# llama-server port (must match docker-compose.llm.yml)
TRUENEX_LLM_PORT=9081

# Number of GPU layers for CUDA profile (999 = all, 0 = CPU)
TRUENEX_LLM_GPU_LAYERS=999
